# CodeLens 通用环境变量模板（本地开发/试用）
# 复制为 server/.env 或部署机上的 /root/codelens/.env 后按需修改；本文件不含任何真实密钥。
# 生产部署（Ubuntu + systemd + nginx）请直接用 deploy/codelens.env.example 与 deploy/install-server.sh。

# 服务监听（默认即安全：只绑本机回环）
HOST=127.0.0.1
PORT=8789
NODE_ENV=production

# 生产用 server/dist/app.js 直接服务前端时需要指向构建产物；用 vite dev 则无需设置
# CLIENT_DIST_DIR=/path/to/codelens/server/dist-client

# 数据与审批签名密钥（留空则首次启动自动生成 0600 密钥文件；生产建议显式生成：openssl rand -hex 32）
AGENT_DB_PATH=
SANDBOX_ROOT=./workspace
AGENT_APPROVAL_SECRET=REPLACE_WITH_RANDOM_32_BYTES

# 试用上游：非空 LLM_SERVER_API_KEY 即把试用通道锁定到 TRIAL_BASE_URL（OpenAI 兼容端点）
# 例：同机 api-relay 网关 http://127.0.0.1:8787/v1 + 其 clients 里的一把 key
LLM_SERVER_API_KEY=REPLACE_WITH_RELAY_CLIENT_KEY
TRIAL_MODE_ENABLED=true
TRIAL_BASE_URL=http://127.0.0.1:8787/v1
TRIAL_MODEL=glm-5.3
TRIAL_DAILY_LIMIT=5

# 模型清单同步（也可用 UI 手动 sync；出厂默认见 config/modelsync.json）
MODEL_SOURCE_URL=http://127.0.0.1:8787/v1/models
MODEL_SOURCE_FORMAT=openai
MODEL_REFRESH_INTERVAL_MS=3600000