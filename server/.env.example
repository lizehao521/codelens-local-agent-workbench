# CodeLens server environment configuration. Copy to .env and adjust.

# HTTP listen port.
PORT=8080

# Runtime environment: development | production | test.
NODE_ENV=development

# Comma-separated CORS origin whitelist. Empty = same-origin only, CORS middleware disabled.
# Example: https://codelens.example.com,https://www.codelens.example.com
ALLOWED_ORIGINS=

# Server-side fallback LLM API key (demo mode). Used only when a request carries no apiKey.
# Leave empty to force BYOK mode. Never commit a real key.
LLM_SERVER_API_KEY=

# Set to true only when running behind a trusted reverse proxy that sets X-Forwarded-For.
# When false, rate limiting uses the raw socket remote address (default, safer).
TRUST_PROXY=

# ── RSI 代际对账仪器（krsi）──
# 指向已编译的 krsi 二进制。留空 = 默认 /tmp/krsi。
# 二进制不存在时不做对账（verdict=skipped），不会把代际记成 error；
# 真值读数仍由 harness 复算，不受影响。
# 编译：go build -C krsi -o <绝对路径>/krsi .
KRSI_BIN_PATH=

# ── Upstream model sync (auto model fetch) ──
# 应用启动即拉取一次；非空 URL 时按 MODEL_REFRESH_INTERVAL_MS 周期刷新。
# 空值 = 禁用自动拉取（仅使用内置静态 provider 目录）。
MODEL_SOURCE_URL=
# 周期刷新间隔（ms）；0 或负数 = 仅启动拉取一次。
MODEL_REFRESH_INTERVAL_MS=3600000
# 单次调度内最大重试次数（指数退避）。
MODEL_SYNC_RETRY_MAX_ATTEMPTS=3
# 退避基数（ms）；实际等待 = base × 2^(attempt-1)。
MODEL_SYNC_RETRY_BACKOFF_MS=1000
# 允许 http（非 https）上游 URL。默认 false（ssrf-guard 拒绝非 https）。
MODEL_SOURCE_ALLOW_INSECURE=false
# 允许私有/回环网段上游（如 127.0.0.1、内网 IP）。默认 false（SSRF 防护拦截）。
# 仅当你确实要把模型源指向内网/本地服务时开启，存在 SSRF 风险，请谨慎。
MODEL_SOURCE_ALLOW_PRIVATE=false
# 上游响应格式：native=按 ModelSourceSchema（失败自动探测 OpenAI /v1/models 列表）；
# openai=显式按 OpenAI 兼容的 /v1/models 列表解析（跳过 ModelSourceSchema 尝试）。
MODEL_SOURCE_FORMAT=native

# ── krsi 内核二进制（RSI 四态判决用）─────────────────────────────────────────
# 不设也能起服务，但**四态判决会全部退化为 verdict=error**（读数看着在跑，其实没判）。
# Windows 必读：默认值 '/tmp/krsi' 是 POSIX 约定，Node 会把它解析成「当前盘根下的 tmp」
# （C:\tmp\krsi），而 Git Bash 的 /tmp 实际是 %TEMP%，两者不是同一处 → spawn ENOENT。
# 所以必须写绝对路径。二进制由 `npm run test:krsi` 编译产出到 os.tmpdir()。
# Linux/macOS 可设为 /tmp/krsi 或任意已编译路径。
# KRSI_BIN_PATH=C:/Users/<you>/AppData/Local/Temp/krsi
