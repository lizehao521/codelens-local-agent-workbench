# CodeLens 演示实例环境变量（部署时复制为 /root/codelens/.env，chmod 600）
PORT=8789
HOST=127.0.0.1
NODE_ENV=production
CLIENT_DIST_DIR=/root/codelens/server/dist-client

# 数据与沙箱
AGENT_DB_PATH=/root/codelens/data/codelens.db
SANDBOX_ROOT=/root/codelens/workspace
CHECKPOINT_ENABLED=true
AGENT_APPROVAL_SECRET=REPLACE_WITH_RANDOM_32_BYTES

# 兜底上游：指向同机 api-relay（非空即强制 provider=custom）
LLM_SERVER_API_KEY=REPLACE_WITH_RELAY_CLIENT_KEY
TRIAL_MODE_ENABLED=true
TRIAL_BASE_URL=http://127.0.0.1:8787/v1
TRIAL_MODEL=qwen3.8-flash-next
TRIAL_DAILY_LIMIT=5

# 1C2G 资源约束
AGENT_MAX_CONCURRENT=1
AGENT_MAX_TOOL_CALLS=30
AGENT_TASK_BUDGET_MS=180000
FALLBACK_GLOBAL_DAILY_TOKEN_LIMIT=2000000
FALLBACK_PER_IP_DAILY_TOKEN_LIMIT=300000
FALLBACK_PER_TASK_TOKEN_LIMIT=120000

# 模型清单从 api-relay 同步
MODEL_SOURCE_URL=http://127.0.0.1:8787/v1/models
MODEL_SOURCE_FORMAT=openai
MODEL_SOURCE_ALLOW_INSECURE=true
MODEL_SOURCE_ALLOW_PRIVATE=true
MODEL_REFRESH_INTERVAL_MS=3600000

# 限流
API_RATE_LIMIT_PER_MIN=120