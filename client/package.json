{
  "name": "codelens-client",
  "private": true,
  "version": "2.20.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:coverage-floor": "node ../scripts/check-coverage-floor.mjs --package=client",
    "check:coverage": "npm run test:coverage && npm run check:coverage-floor",
    "check:file-size": "node ../scripts/check-file-size.mjs",
    "typecheck": "tsc --noEmit",
    "check:ui-static": "node scripts/check-ui-static.mjs",
    "test:acceptance": "npm run typecheck && npm run test && npm run check:ui-static && npm run check:file-size"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
